{
  "name": "hostdeck",
  "productName": "Hostdeck",
  "version": "0.1.0",
  "description": "A local-first SSH server manager for Linux, Windows and macOS. Save your servers, run commands, open terminals and edit files over SFTP.",
  "main": "src/main/main.js",
  "author": {
    "name": "Rami Atoui",
    "url": "https://ramiatoui.com"
  },
  "license": "MIT",
  "homepage": "https://ramiatoui.com/hostdeck",
  "repository": {
    "type": "git",
    "url": "https://github.com/ramiatoui/hostdeck.git"
  },
  "keywords": [
    "ssh",
    "sftp",
    "server",
    "terminal",
    "electron",
    "devops"
  ],
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "watch:renderer": "node scripts/build-renderer.js --watch",
    "start": "npm run build:renderer && electron .",
    "test": "node --test --test-timeout=30000 test/*.test.js",
    "dist": "npm run build:renderer && electron-builder",
    "dist:linux": "npm run build:renderer && electron-builder --linux",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "dist:mac": "npm run build:renderer && electron-builder --mac"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.ramiatoui.hostdeck",
    "productName": "Hostdeck",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**",
      "src/preload.js",
      "src/renderer/index.html",
      "src/renderer/styles.css",
      "dist/**",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "Rami Atoui",
      "synopsis": "Local-first SSH server manager"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "publish": {
      "provider": "github",
      "owner": "ramiatoui",
      "repo": "hostdeck"
    }
  }
}
